# Browser-visible API origin for REST (no trailing slash; paths use `/api/v1/...` from shared constants)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional: enable dev-only oRPC client when backend exposes `/rpc` (`ORPC_PUBLIC_ENABLED=true` on Nest)
NEXT_PUBLIC_ORPC_URL=http://localhost:3000/rpc

# Keycloak (browser / OIDC; optional until FE login is wired). Matches docker-compose `keycloak` + realm `topcv`.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=topcv
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=topcv-api
