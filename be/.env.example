# Backend HTTP
PORT=3000

# Runtime environment (used for dev-only error logging).
# Common values: development | production | test
NODE_ENV=development

# CORS: browser origins allowed to call the API (Next CSR on another port is cross-origin).
# Comma-separated if you use several URLs (e.g. LAN preview http://10.x.x.x:3001).
FRONTEND_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Rate limiting (Nest throttler; ttl in seconds)
# Set to false to disable throttling (tests disable by default).
# THROTTLE_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# MongoDB (matches docker-compose `mongodb` service)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=topcv

# Redis (docker-compose `redis`)
REDIS_URL=redis://localhost:6379

# Elasticsearch (docker-compose `elasticsearch`; client major must match server, see README)
ELASTICSEARCH_URL=http://localhost:9200

# Keycloak JWT (docker-compose `keycloak`; realm imported from infrastructure/keycloak/topcv.json)
# Issuer must match token `iss` (no trailing slash).
KEYCLOAK_ISSUER=http://localhost:8080/realms/topcv
# Optional: defaults to ${KEYCLOAK_ISSUER}/protocol/openid-connect/certs
# KEYCLOAK_JWKS_URL=http://localhost:8080/realms/topcv/protocol/openid-connect/certs
# Optional: set if access tokens declare an audience you want enforced
# KEYCLOAK_AUDIENCE=
# Optional: include client roles from resource_access[KEYCLOAK_CLIENT_ID] (see realm client topcv-api)
KEYCLOAK_CLIENT_ID=topcv-api
# Optional: only if `KEYCLOAK_CLIENT_ID` is a confidential client (public clients omit this).
# Used by `POST /auth/refresh` when Keycloak requires `client_secret` on the token endpoint.
# KEYCLOAK_CLIENT_SECRET=

# Keycloak Admin API (service client; required for `/auth/register`)
KEYCLOAK_ADMIN_CLIENT_ID=topcv-bff
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-topcv-bff-secret

# Public registration hardening.
# Admin signup is disabled by default; enable only in trusted environments.
ALLOW_ADMIN_SIGNUP=false
